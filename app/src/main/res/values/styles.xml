<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      API-independent theme definitions. API 27 adds
      android:windowLightNavigationBar in values-v27/styles.xml.
    -->
    <style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/ospy_green</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/ospy_background</item>
    </style>

    <style name="AppTheme" parent="@style/AppThemeBase" />

    <style name="AppThemeDarkBase" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/ospy_green_dark_theme</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/ospy_dark_background</item>
    </style>

    <style name="AppThemeDark" parent="@style/AppThemeDarkBase" />
</resources>
