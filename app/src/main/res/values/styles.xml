<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/ospy_green</item>
        <item name="android:navigationBarColor">@color/ospy_navy</item>
        <item name="android:statusBarColor">@color/ospy_green</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/ospy_background</item>
    </style>

    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/ospy_green_dark_theme</item>
        <item name="android:navigationBarColor">@color/ospy_dark_background</item>
        <item name="android:statusBarColor">@color/ospy_green_dark_theme</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/ospy_dark_background</item>
    </style>
</resources>
